From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] ggml: 16-byte-aligned malloc for Memory64 (wasm64) builds

Emscripten memory64's posix_memalign does not reliably honor its
alignment argument — it can return 8-byte-aligned pointers, violating
GGML_MEM_ALIGN=16 and tripping GGML_ASSERT_ALIGNED(ctx->mem_buffer) in
ggml_init().

Under __wasm64__, over-allocate and align manually, stashing the
original malloc pointer in the word immediately before the aligned
address. ggml_aligned_free mirrors the same header layout.

diff --git a/llama.cpp/ggml/src/ggml.c b/llama.cpp/ggml/src/ggml.c
--- a/llama.cpp/ggml/src/ggml.c
+++ b/llama.cpp/ggml/src/ggml.c
@@ -307,6 +307,20 @@ void * ggml_aligned_malloc(size_t size) {
     void * aligned_memory = NULL;
   #ifdef GGML_USE_CPU_HBM
     int result = hbw_posix_memalign(&aligned_memory, alignment, size);
+  #elif defined(__EMSCRIPTEN__)
+    // Emscripten (esp. Memory64): posix_memalign may not honor alignment; over-allocate and align manually.
+    size_t total = size + alignment + sizeof(void*);
+    void * raw = malloc(total);
+    int result;
+    if (!raw) {
+        result = ENOMEM;
+    } else {
+        uintptr_t addr = (uintptr_t)raw + sizeof(void*);
+        addr = (addr + alignment - 1) & ~(uintptr_t)(alignment - 1);
+        aligned_memory = (void*)addr;
+        ((void**)aligned_memory)[-1] = raw;
+        result = 0;
+    }
   #elif TARGET_OS_OSX
     GGML_UNUSED(alignment);
     kern_return_t alloc_status = vm_allocate((vm_map_t) mach_task_self(), (vm_address_t *) &aligned_memory, size, VM_FLAGS_ANYWHERE);
@@ -350,6 +364,10 @@ void ggml_aligned_free(void * ptr, size_t size) {
     GGML_UNUSED(size);
 #if defined(_MSC_VER) || defined(__MINGW32__)
     _aligned_free(ptr);
+#elif defined(__EMSCRIPTEN__)
+    if (ptr != NULL) {
+        free(((void**)ptr)[-1]);
+    }
 #elif GGML_USE_CPU_HBM
     if (ptr != NULL) {
         hbw_free(ptr);
diff --git a/llama.cpp/src/llama-graph.cpp b/llama.cpp/src/llama-graph.cpp
--- a/llama.cpp/src/llama-graph.cpp
+++ b/llama.cpp/src/llama-graph.cpp
@@ -487,11 +487,17 @@

     inputs.clear();

-    buf_compute_meta.resize(ggml_tensor_overhead()*max_nodes + ggml_graph_overhead_custom(max_nodes, false));
+    // Memory64: GGML_MEM_ALIGN=16 requires 16-byte-aligned mem_buffer.
+    // std::vector<uint8_t> only guarantees 8-byte alignment from malloc under Emscripten.
+    // Overallocate by (GGML_MEM_ALIGN-1) and compute the aligned start pointer.
+    const size_t meta_size = ggml_tensor_overhead()*max_nodes + ggml_graph_overhead_custom(max_nodes, false);
+    buf_compute_meta.resize(meta_size + GGML_MEM_ALIGN - 1);
+    uint8_t * meta_ptr = buf_compute_meta.data();
+    meta_ptr = (uint8_t *)(((uintptr_t)meta_ptr + GGML_MEM_ALIGN - 1) & ~((uintptr_t)(GGML_MEM_ALIGN - 1)));

     ggml_init_params params = {
-        /*.mem_size   =*/ buf_compute_meta.size(),
-        /*.mem_buffer =*/ buf_compute_meta.data(),
+        /*.mem_size   =*/ meta_size,
+        /*.mem_buffer =*/ meta_ptr,
         /*.no_alloc   =*/ true,
     };
